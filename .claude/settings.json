{
  "permissions": {
    "allow": [
      "Bash(python scripts/*)",
      "Bash(python3 scripts/*)",
      "Bash(pytest:*)",
      "Bash(dbt:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git merge:*)",
      "Bash(rm -rf:*)",
      "Edit(./scripts/**)",
      "Write(./scripts/**)",
      "Edit(./.github/**)",
      "Write(./.github/**)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Edit(./.squad/**)",
      "Write(./.squad/**)",
      "Edit(./templates/**)",
      "Write(./templates/**)",
      "Edit(./AGENTS.md)",
      "Write(./AGENTS.md)",
      "Edit(./CLAUDE.md)",
      "Write(./CLAUDE.md)",
      "Edit(./pytest.ini)",
      "Write(./pytest.ini)",
      "Edit(./requirements-dev.txt)",
      "Write(./requirements-dev.txt)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hook_validate.py\""
          }
        ]
      }
    ]
  }
}
